# --- Игровые ассеты (копирайт Coolmath Games) -------------------------------
# Лежат локально, чтобы игра запускалась, но в Git не попадают.
/images/
/sounds/
/scripts/
/fonts/
/styles/
/assets/

# --- Прочее ----------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
__pycache__/
node_modules/

# --- Собранные архивы ------------------------------------------------------
# Из release/ в git попадает только готовый архив мода (он без игровых файлов),
# всё остальное (распакованные сцены сборки) — нет.
/release/*
!/release/awesome-tanks-2.0-mod.zip
!/release/awesome-tanks-2.0-mod.zip.sha256
/dist/

